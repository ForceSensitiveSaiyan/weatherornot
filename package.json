{
  "name": "weatherornot",
  "version": "0.1.0",
  "description": "A free daily game: 3 quick questions on tomorrow's weather in the UK, settled on official weather station readings.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "WEATHER_PROVIDER=mock node --no-warnings=ExperimentalWarning --watch src/server.js",
    "test": "node --no-warnings=ExperimentalWarning --test",
    "simulate": "node --no-warnings=ExperimentalWarning scripts/simulate.mjs"
  }
}
